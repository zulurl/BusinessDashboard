<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BusinessDashboard.ViewDataPage"
             Title="Consultar Dados">

    <ScrollView>
        <StackLayout Padding="10">

            <Label Text="Dados de Ganhos"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <CollectionView x:Name="EarningsCollectionView"
                            Margin="0,5,0,5">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame Padding="10"
                               Margin="5"
                               BackgroundColor="LightGray"
                               CornerRadius="8">

                            <VerticalStackLayout Spacing="5">

                                <Label Text="{Binding Timestamp,
                                    StringFormat='Data: {0:dd/MM/yyyy HH:mm}'}"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding CashierEarnings,
                                    StringFormat='Caixa: {0:C}'}" />

                                <Label Text="{Binding TipsEarnings,
                                    StringFormat='Gorjetas: {0:C}'}" />

                                <Label Text="{Binding DailyExpenses,
                                    StringFormat='Despesas: {0:C}'}" />

                                <Label Text="{Binding TotalEarningsSoFar,
                                    StringFormat='Ganhos Totais: {0:C}'}" />

                                <Label Text="{Binding TotalExpensesSoFar,
                                    StringFormat='Despesas Totais: {0:C}'}" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button Text="Atualizar"
                    Clicked="OnRefreshClicked"
                    HorizontalOptions="Center"
                    Margin="10" />

        </StackLayout>
    </ScrollView>

</ContentPage>

    